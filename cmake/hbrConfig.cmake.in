@PACKAGE_INIT@
set(hbr_cpu_FOUND TRUE)
set(hbr_cuda_FOUND @HBR_CUDA@)
set(hbr_FOUND TRUE)
unset(hbr_NOT_FOUND_MESSAGE)
foreach(component IN LISTS hbr_FIND_COMPONENTS)
  if(NOT component STREQUAL "cpu" AND NOT component STREQUAL "cuda")
    set(hbr_${component}_FOUND FALSE)
    if(hbr_FIND_REQUIRED_${component})
      string(APPEND hbr_NOT_FOUND_MESSAGE "Unsupported hbr component '${component}'. Supported components are cpu and cuda. ")
    endif()
  elseif(component STREQUAL "cuda" AND NOT hbr_cuda_FOUND AND hbr_FIND_REQUIRED_cuda)
    string(APPEND hbr_NOT_FOUND_MESSAGE "The hbr cuda component was not built. Configure the producer with HBR_CUDA=ON. ")
  endif()
endforeach()
check_required_components(hbr)
if(NOT hbr_FOUND)
  return()
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@HBR_CUDA@)
  find_dependency(CUDAToolkit)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/hbrTargets.cmake")
